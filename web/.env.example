# CampusPay Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_MOCKS=true

# Supabase
# Dashboard > Project Settings > Data API ou Connect panel.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA
# Compatibilidade com projetos que ainda chamam a chave publica de anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca use em componente client-side.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Supabase Storage
NEXT_PUBLIC_SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_DOCUMENTS_BUCKET=documents

# Solana
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_TREASURY_ADDRESS=11111111111111111111111111111111
NEXT_PUBLIC_SOLANA_USDC_MINT=
SOLANA_REPORT_ANCHOR_MODE=memo
SOLANA_REPORT_ANCHOR_PROGRAM_ID=
SOLANA_VALIDATE_TRANSACTIONS=false

# Pix / PSP adapter
PIX_PROVIDER=mock
PIX_WEBHOOK_SECRET=troque-por-um-segredo-grande

# Segurança operacional
REPORT_HASH_SALT=troque-por-um-salt-do-projeto
APP_ADMIN_EMAILS=
